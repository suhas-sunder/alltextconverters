{
  "name": "alltextconverters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "prebuild": "npm run generate:sitemap",
    "build": "react-router build",
    "postbuild": "node scripts/finalize-static-build.mjs && node --test tests/static-build.test.mjs",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc -b",
    "test": "npm run generate:sitemap && node --test --test-concurrency=1 tests/foundation.test.mjs tests/text-tools.static.test.mjs tests/encoding-xml.behavior.test.mjs tests/case-counter.behavior.test.mjs tests/converter-ui.behavior.test.mjs",
    "audit:static": "node --test tests/static-build.test.mjs",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "mammoth": "^1.11.0",
    "pdfjs-dist": "^5.4.530",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@react-router/dev": "^8.3.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "@xmldom/xmldom": "0.8.13",
    "dompurify": "3.4.12",
    "underscore": "1.13.8"
  }
}
